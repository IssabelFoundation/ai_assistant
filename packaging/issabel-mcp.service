[Unit]
Description=Issabel MCP and BYOK assistant service
After=network-online.target httpd.service
Wants=network-online.target

[Service]
Type=simple
User=issabel-mcp
Group=issabel-ai
EnvironmentFile=-/etc/sysconfig/issabel-mcp
ExecStart=/usr/sbin/issabel-mcp -mode serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/issabel-mcp
ReadOnlyPaths=/etc/issabel-mcp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=multi-user.target
